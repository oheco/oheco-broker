# Copy to an operator-owned .env.acme and fill all empty required values.
# No token or private key belongs in this file.
BROKER_IMAGE=ghcr.io/oheco/oheco-broker:0.3.0

# One public DNS name (no scheme, port, path, or wildcard); A record reaches this host.
BROKER_DOMAIN=
# Actual externally reachable IPv4 announced by TURN; never 0.0.0.0.
BROKER_PUBLIC_IPV4=

# Absolute existing directories prepared for UID/GID 10001; see docs/DOCKER.md.
BROKER_DATA_DIR=
BROKER_SECRETS_DIR=

# Explicitly set true only after accepting the chosen ACME CA's terms.
BROKER_ACME_ACCEPT_TOS=
# Optional contact; an empty directory URL selects Let's Encrypt production.
BROKER_ACME_EMAIL=
BROKER_ACME_DIRECTORY=

# Inclusive UDP relay pool; match host firewall/security group/NAT rules.
BROKER_RELAY_MIN_PORT=50000
BROKER_RELAY_MAX_PORT=50100
