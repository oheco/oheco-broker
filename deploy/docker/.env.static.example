# Copy to an operator-owned .env.static and fill all empty required values.
# No token, private key, or DNS-provider credential belongs in this file.
BROKER_IMAGE=ghcr.io/oheco/oheco-broker:0.3.0

# Actual externally reachable IPv4 announced by TURN; never 0.0.0.0.
BROKER_PUBLIC_IPV4=
# HTTPS TCP port; 3478 coexists with TURN UDP 3478. Use an unprivileged port here.
BROKER_HTTPS_PORT=3478

# Absolute existing directories prepared for UID/GID 10001; see docs/DOCKER.md.
BROKER_DATA_DIR=
BROKER_SECRETS_DIR=
# Whole export directory with ordinary fullchain.pem and privkey.pem files.
BROKER_CERT_DIR=

# Inclusive UDP relay pool; match host firewall/security group/NAT rules.
BROKER_RELAY_MIN_PORT=50000
BROKER_RELAY_MAX_PORT=50100
