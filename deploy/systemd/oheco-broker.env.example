# Copy to /etc/oheco-broker/oheco-broker.env and set all deployment inputs.
# The service runs as oheco-broker. Use unprivileged ports or a separately
# managed frontend. The private key and admin token must belong to that account.
OHECO_BROKER_LISTEN=0.0.0.0:8443
OHECO_BROKER_ADMIN_TOKEN_FILE=/etc/oheco-broker/admin.token
OHECO_BROKER_TLS_CERT=/etc/oheco-broker/tls/server.crt
OHECO_BROKER_TLS_KEY=/etc/oheco-broker/tls/server.key
OHECO_BROKER_TURN_LISTEN=0.0.0.0:3478
# Replace this placeholder with the public IPv4 address advertised by this host.
OHECO_BROKER_TURN_PUBLIC_IP=REPLACE_WITH_PUBLIC_IPV4
OHECO_BROKER_TURN_RELAY_MIN_PORT=50000
OHECO_BROKER_TURN_RELAY_MAX_PORT=59999
# New databases start with approval registration and relay disabled for new
# accounts. Existing SQLite settings take precedence; administer them explicitly.
